# =============================================================
# ChannelPilot AI v12 — Private / Commercial Edition
# =============================================================

# Telegram bot
TELEGRAM_BOT_TOKEN=put_your_telegram_bot_token_here

# Railway PostgreSQL:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://channelpilot:channelpilot@localhost:5432/channelpilot

# Project metadata
PROJECT_EDITION=private_commercial
PROJECT_NAME=Professional Channel Network
SUPPORT_CONTACT=@support_username
AI_APP_NAME=ChannelPilot Pro

# Access/security
BOT_ACCESS_MODE=private
REQUIRE_ADMIN_IDS=true
ADMIN_IDS=123456789

# Strict whitelist of channels the bot is allowed to use.
# Leave empty only if you intentionally want to allow any verified owned channel.
ALLOWED_CHANNELS=@client_news,@brand_media

# Channel security
REQUIRE_CHANNEL_VERIFICATION=true
PUBLIC_REQUIRE_TERMS_ACCEPTANCE=false
PUBLIC_REQUIRE_USER_CHANNEL_ADMIN=true
PUBLIC_DOUBLE_CONFIRM_PUBLISH=true
PUBLIC_ALLOW_AUTO_PUBLISH=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
MAX_COMMANDS_PER_WINDOW=24
SOURCE_URL_PRIVATE_NETWORKS_BLOCKED=true

# AI provider. OpenRouter-compatible by default.
AI_API_KEY=put_your_openrouter_or_openai_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_FAST_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.28
AI_SITE_URL=https://example.com
AI_REQUEST_TIMEOUT=25

# Cost control
COST_SAVER_ENABLED=true
COST_SAVER_MODE=cheap
AI_CACHE_ENABLED=true
AI_CACHE_TTL_HOURS=168
AI_DAILY_TOKEN_BUDGET=50000
AI_MONTHLY_TOKEN_BUDGET=1000000
AI_PROMPT_MAX_ARTICLES=4
AI_SOURCE_SUMMARY_CHARS=420
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=800
EDITORIAL_PROMPT_MAX_CHARS=6000
PROMPT_POST_MAX_CHANNELS=5

# Natural AI Control
NATURAL_CONTROL_ENABLED=true
NATURAL_CONTROL_USE_AI=true
NATURAL_CONTROL_REQUIRE_CONFIRM_FOR_PUBLISH=true
BOT_DM_PARSE_MODE=markdown_v2

# News/search providers. Optional, RSS works without them.
NEWSAPI_KEY=
NEWSAPI_LANGUAGES=ru,en
BRAVE_SEARCH_API_KEY=

# News quality
MAX_ARTICLE_AGE_HOURS=72
DEFAULT_MIN_SOURCES=2
MAX_ARTICLES_PER_REQUEST=8
RSS_CACHE_TTL_SECONDS=300
SEARCH_CACHE_TTL_SECONDS=600
DUPLICATE_TOPIC_WINDOW_DAYS=14
AUTOPILOT_MIN_SCORE=65
AUTOPILOT_SLOT_WINDOW_MINUTES=5
TOPIC_RELEVANCE_ENABLED=true
TOPIC_RELEVANCE_MIN_SCORE=35
TOPIC_RELEVANCE_STRICT_MIN_SCORE=45

# Media
EXTRACT_ARTICLE_MEDIA=true
ARTICLE_MEDIA_FETCH_LIMIT=6
MEDIA_ENABLED_BY_DEFAULT=true
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_STORAGE_DIR=data/media
MEDIA_MAX_BYTES=15000000
TELEGRAM_CAPTION_LIMIT=1024
POST_FORMAT_DEFAULT=markdown_v2
POST_LINK_PREVIEW_ENABLED=true

# Public footer in channel posts. Default: hide raw source URLs and show only
# a clean subscription CTA: "Подписаться на TG Media Lab" with TG Media Lab clickable.
SOURCE_FOOTER_MODE=brand_cta
POST_SOURCE_DEBUG_ENABLED=false
BRAND_CTA_ENABLED=true
BRAND_CTA_PREFIX=Подписаться на
BRAND_CTA_LABEL=TG Media Lab
BRAND_CTA_URL=https://t.me/TMediaLabG

# Runtime
PORT=8080
HEALTH_HOST=0.0.0.0
HEALTH_SERVER_ENABLED=true
DATABASE_INIT_RETRIES=40
DATABASE_INIT_RETRY_SECONDS=2.0
LOG_LEVEL=INFO

# =============================================================
# v20 Production Guardrails
# =============================================================
AI_ROUTER_MODEL=
AI_DRAFT_MODEL=
AI_REWRITE_MODEL=
AI_REVIEW_MODEL=
AI_QUALITY_MODEL=
AI_DEFAULT_MODEL=

MAX_AI_REQUESTS_PER_DAY=300
NEWSAPI_DAILY_LIMIT=80
MAX_DIGESTS_PER_DAY=10
MAX_NEWS_PER_CHANNEL_PER_DAY=30
MAX_NATURAL_REQUESTS_PER_DAY=200
MAX_PROMPT_LENGTH=6000

DEMO_MODE=false
DEMO_EXPIRES_DAYS=7
DEMO_MAX_POSTS_PER_DAY=5
DEMO_MAX_CHANNELS=1
DEMO_REQUIRE_CONFIRMATION=true

MEDIA_RELEVANCE_ENABLED=true
MEDIA_RELEVANCE_MIN_SCORE=55
ANTI_CRINGE_ENABLED=true
AUDIT_ENABLED=true
CONTENT_DAY_ENABLED=true
